    "hono": "4.13.12",
    "nanoid": "3.3.19",
    "playwright-core": "1.63.0",
    "postcss": "8.5.28",
    "vite": "7.3.6",
    "rollup": "4.64.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
